VITE_API_BASE_URL=http://127.0.0.1:8002
# 老人端后端（SOS 事件单一来源），监护人端 api 模式下直查
VITE_ELDER_API_BASE_URL=http://127.0.0.1:8001
# 健康数据来源：mock（默认，本地演示六态）| api（真实后端 /api/v1/health-overview 契约）
VITE_HEALTH_DATA_MODE=mock
# SOS 求助事件来源：mock（默认，消息中心维持演示现状）| api（直查老人端后端 /api/v1/sos-events）
VITE_SOS_DATA_MODE=mock
