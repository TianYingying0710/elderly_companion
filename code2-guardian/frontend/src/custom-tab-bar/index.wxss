.tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000; background: #fff; border-top: 1rpx solid #e8edf5; }
.tab-row { display: flex; min-height: 112rpx; }
.tab-item { flex: 1; min-height: 88rpx; padding: 12rpx 0; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; transition: background-color .12s, opacity .12s; }
.tab-item--pressed { background: #f1f5fd; opacity: .72; }
.tab-icon { width: 46rpx; height: 46rpx; }
.tab-label { margin-top: 6rpx; font-size: 22rpx; color: #9aa3b2; }
.selected .tab-label { color: #2563eb; font-weight: 500; }
.safe-area { height: env(safe-area-inset-bottom); }
