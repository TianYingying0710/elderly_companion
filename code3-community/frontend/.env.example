VITE_API_BASE_URL=http://127.0.0.1:8003
# 老人端后端（助老课程、知识内容与 SOS 事件的单一内容源），api 模式下直查
VITE_ELDER_API_BASE_URL=http://127.0.0.1:8001
# VITE_SOS_DATA_MODE：mock（默认，救援处置页保持本地演示数据）| api（直查老人端后端 /api/v1/sos-events，状态推进走 POST /api/v1/sos-events/{id}/transitions，本端不自建状态机）
VITE_SOS_DATA_MODE=mock
# 助老课程目录与发布来源：mock（默认，助老课程页维持演示现状）| api（直查老人端后端 /api/v1/courses、/api/v1/course-videos）
VITE_COURSE_DATA_MODE=mock

# 跨端联调提示：微信开发者工具与真机都访问不到电脑的 127.0.0.1，
# 需把上面两个地址改成电脑当前局域网 IPv4；本文件只放占位地址，
# 真实机器地址写在 .env.local（已被 .gitignore 忽略，不入库）。
