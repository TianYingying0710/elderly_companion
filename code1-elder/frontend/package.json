{
  "name": "silver-companion-elder-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run type-check && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "android:verify": "powershell -ExecutionPolicy Bypass -File ../../scripts/test-elder-android-environment.ps1 && npm run android:sync && npm run android:build",
    "android:open": "cap open android",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
