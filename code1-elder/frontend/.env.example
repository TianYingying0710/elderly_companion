# 浏览器本机调试可使用 127.0.0.1；Android 真机/模拟器需改成电脑当前局域网 IPv4 地址。
VITE_API_BASE_URL=http://192.168.1.100:8001
# 默认构建演示版；false 启动未接入业务状态，界面也可手动切换。
VITE_DEMO_MODE=true

# SOS 数据源：mock（默认，本地模拟）/ api（调老人端后端 :8001 真实契约，事件存进程内，重启即清）。
VITE_SOS_DATA_MODE=mock
# api 模式下 SOS 上报与状态查询地址（与 VITE_API_BASE_URL 同源时可省略，代码会回退到它）。
# Android 端不能写 127.0.0.1：那是设备自身的回环地址，指向不到电脑上的后端。
VITE_ELDER_API_BASE_URL=http://192.168.1.100:8001
# 助老课程数据源：mock（默认，本地演示课程）/ api（直查课程服务 GET /api/v1/courses*，视频经 video_url 流式播放）。
VITE_COURSE_DATA_MODE=mock
